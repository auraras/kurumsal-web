
---
import { getEntry, render } from "astro:content";

const home = await getEntry("pages", "home");

if (!home) {
  throw new Error("Ana sayfa içeriği bulunamadı");
}

const { Content } = await render(home);
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <title>{home.data.title}</title>
    <meta
      name="description"
      content={home.data.description}
    />
  </head>
  <body>
    <main>
      <section>
        <h1>{home.data.heroTitle}</h1>
        <p>{home.data.heroDescription}</p>
      </section>

      <article>
        <Content />
      </article>
    </main>
  </body>
</html>
